    "drizzle-orm": "0.45.2",
    "fabric": "^7.4.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "^1.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "cf": "^1.0.0-beta.14",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
