# PostgreSQL connection string. Required by the app in production and by Drizzle Kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Use the local JSON database only during non-production development.
# Set to false to use PostgreSQL locally. Production always uses PostgreSQL.
LOCAL_JSON_DB=true

# Optional hosted copy refinement and free-model discovery through OpenRouter.
# Leave blank to use the built-in creative engine.
OPENROUTER_API_KEY=

# Optional default model slug used when the generation model is automatic.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter image endpoint/model overrides. OPENROUTER_API_KEY is reused automatically.
IMAGE_API_BASE_URL=https://openrouter.ai/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=openai/gpt-image-2
