# Database configuration
# Set LOCAL_JSON_DB=true to use the built-in local JSON database (.local-db/database.json)
LOCAL_JSON_DB=true
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# OpenRouter API Configuration
OPENROUTER_API_KEY=

# Best OpenRouter model for content generation & prompt engineering
# Options:
# - openai/gpt-4o (Recommended: Flagship SOTA reasoning & copywriting)
# - openai/gpt-4o-mini (Blazing fast, highly capable, cost-effective)
# - nvidia/nemotron-3-super-120b-a12b:free (Top 120B parameter free model)
# - openrouter/free (Universal free router with automatic failover)
OPENROUTER_MODEL=openai/gpt-4o

# Agnes AI Image Generation (SOTA photorealistic architectural imagery)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-image-2.5-flash

# Standard Image API aliases (if using alternative provider or FLUX.1)
# IMAGE_API_BASE_URL=https://apihub.agnes-ai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=agnes-image-2.5-flash
