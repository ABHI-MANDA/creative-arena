# Database configuration
# Set LOCAL_JSON_DB=true to use the built-in local JSON database (.local-db/database.json)
LOCAL_JSON_DB=true
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# OpenRouter API Configuration
OPENROUTER_API_KEY=

# Content writing & copywriting generation model
# - agnes-3.0-flash (Recommended: Ultra-fast real-estate copywriting & prompt engineering via Agnes AI)
# - openai/gpt-4o / openai/gpt-4o-mini (OpenRouter alternatives)
AGNES_TEXT_MODEL=agnes-3.0-flash
OPENROUTER_MODEL=agnes-3.0-flash

# Agnes AI API Configuration
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# Image generation model: agnes-image-2.1-flash (Recommended SOTA photorealistic architecture)
AGNES_MODEL=agnes-image-2.1-flash

# Standard Image API aliases (if using alternative provider or FLUX.1)
# IMAGE_API_BASE_URL=https://apihub.agnes-ai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=agnes-image-2.1-flash
