# Database configuration
# Set LOCAL_JSON_DB=true to use the built-in local JSON database (.local-db/database.json)
LOCAL_JSON_DB=true
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# OpenRouter API Configuration
OPENROUTER_API_KEY=

# Best free text generation model (unlimited usage, 0 credits required)
# Options:
# - openrouter/free (Recommended: universal router with automatic failover)
# - google/gemma-4-31b-it:free (Google Gemma 4 31B instruction-tuned)
# - nvidia/nemotron-3-super-120b-a12b:free (NVIDIA Nemotron 3 Super 120B)
OPENROUTER_MODEL=openrouter/free

# Best free image generation model (unlimited usage, 0 credits required)
# Options:
# - black-forest-labs/FLUX.1-schnell:free (Recommended: photorealistic architectural imagery)
# - black-forest-labs/FLUX.1-dev:free (High fidelity FLUX.1 variant)
IMAGE_API_BASE_URL=https://openrouter.ai/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell:free
